+class SplitWarpingSpadePredictor:
+    """
+    OneLive V2 M0 spike: warping_spade.onnx contains two 5D GridSample nodes that
+    neither DirectML (kernel creation fails, 0x80004005) nor OpenVINO GPU
+    (4D-only GridSample) can execute, forcing the whole 402MB model onto CPU
+    (~4-8 s/frame). Workaround: the model is pre-split at the two GridSample
+    boundaries into 3 ONNX parts (see engine/tools note in spike-results.md):
+      partA (dense-motion prep)  -> OV GPU fails on a 7D Tile, runs on ORT-DML
+      grid_sample #1             -> torch CPU F.grid_sample (5D bilinear)
+      partB (dense-motion rest)  -> OpenVINO GPU (fp16)
+      grid_sample #2             -> torch CPU
+      partC (SPADE decoder)      -> OpenVINO GPU (fp16)
+    Measured: ~0.6 s/frame vs ~2.1 s (all-DML split) vs ~4-8 s (pure CPU).
+    Disable via ONELIVE_WARPING_SPLIT=0; force OV precision via
+    ONELIVE_OV_PRECISION (default: device default = fp16 on Arc GPU).
+    """
+    _instances = {}
+    _lock = threading.Lock()
+
+    def __new__(cls, **kwargs):
+        model_path = kwargs.get("model_path", "")
+        with cls._lock:
+            if model_path not in cls._instances:
+                inst = super().__new__(cls)
+                inst._init_once(**kwargs)
+                cls._instances[model_path] = inst
+        return cls._instances[model_path]
+
+    def _init_once(self, **kwargs):
+        import json
+        import torch.nn.functional  # noqa: F401 (used in predict)
+        model_path = kwargs.get("model_path", "")
+        model_dir = os.path.dirname(os.path.abspath(model_path))
+        with open(os.path.join(model_dir, "warping_spade_dml_split.json")) as f:
+            self.manifest = json.load(f)
+        # This predictor is a shared singleton (one instance per model_path) and
+        # OpenVINO InferRequest objects are NOT thread-safe: concurrent infer()
+        # raises REQUEST_BUSY or corrupts results. predict() takes this lock, so
+        # multiple pipeline instances serialize on warping_spade.
+        self._predict_lock = threading.Lock()
+        import openvino as ov
+        core = ov.Core()
+        ov_config = {}
+        prec = os.environ.get("ONELIVE_OV_PRECISION", "")
+        if prec:
+            ov_config["INFERENCE_PRECISION_HINT"] = prec
+        self._steps = []
+        for step in self.manifest["steps"]:
+            if step["type"] != "onnx":
+                self._steps.append((step, None, None))
+                continue
+            part_path = os.path.join(model_dir, step["file"])
+            try:
+                cm = core.compile_model(part_path, "GPU", ov_config)
+                self._steps.append((step, "ov", cm.create_infer_request()))
+                backend = "OpenVINO-GPU"
+            except Exception as e:
+                opts = onnxruntime.SessionOptions()
+                opts.log_severity_level = 3
+                sess = onnxruntime.InferenceSession(
+                    part_path,
+                    providers=[("DmlExecutionProvider",
+                                {"device_id": 0, "disable_metacommands": True}),
+                               "CPUExecutionProvider"],
+                    sess_options=opts)
+                self._steps.append((step, "ort", sess))
+                backend = f"ORT-{sess.get_providers()[0]}"
+            print(f"warping_spade split: {step['file']} -> {backend}")
+        self.inputs = [_TensorSpec(n) for n in self.manifest["original_inputs"]]
+        self.outputs = [_TensorSpec(n) for n in self.manifest["original_outputs"]]
+
+    def input_spec(self):
+        return [(s.name, s.shape, s.type) for s in self.inputs]
+
+    def output_spec(self):
+        return [(s.name, s.shape, s.type) for s in self.outputs]
+
+    def predict(self, *data):
+        with self._predict_lock:
+            return self._predict_locked(*data)
+
+    def _predict_locked(self, *data):
+        import torch.nn.functional as F
+        assert len(data) == len(self.inputs), \
+            f"warping_spade split expects {len(self.inputs)} inputs, got {len(data)}"
+        tensors = {}
+        for spec, arr in zip(self.inputs, data):
+            tensors[spec.name] = np.ascontiguousarray(arr, dtype=np.float32)
+        for step, kind, runner in self._steps:
+            if step["type"] == "grid_sample":
+                x = torch.from_numpy(np.ascontiguousarray(tensors[step["x"]]))
+                grid = torch.from_numpy(np.ascontiguousarray(tensors[step["grid"]]))
+                out = F.grid_sample(x, grid,
+                                    mode=step.get("mode", "bilinear"),
+                                    padding_mode=step.get("padding_mode", "zeros"),
+                                    align_corners=bool(step.get("align_corners", 0)))
+                tensors[step["out"]] = out.numpy()
+            elif kind == "ov":
+                feeds = {n: np.ascontiguousarray(tensors[n]) for n in step["inputs"]}
+                result = runner.infer(feeds)
+                for port, arr in result.items():
+                    for name in port.get_names():
+                        if name in step["outputs"]:
+                            tensors[name] = arr
+            else:  # ort
+                feeds = {n: np.ascontiguousarray(tensors[n]) for n in step["inputs"]}
+                outs = runner.run(step["outputs"], feeds)
+                tensors.update(dict(zip(step["outputs"], outs)))
+        return [tensors[n] for n in self.manifest["original_outputs"]]
+
+    def __del__(self):
+        pass
